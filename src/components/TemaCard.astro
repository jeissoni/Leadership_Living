---
interface Props {
  href: string;
  title: string;
  description: string;
  order: number;
  duration?: string;
  hasAudio?: boolean;
}

const { href, title, description, order, duration, hasAudio } = Astro.props;
---

<a class="card" href={href}>
  <div class="card-top">
    <span class="tag">Charla {order}</span>
    <span class="card-meta">
      {duration && <span>{duration}</span>}
      {hasAudio && <span>Audio</span>}
    </span>
  </div>
  <h2>{title}</h2>
  <p>{description}</p>
  <div class="card-foot">
    <span>Recordar</span>
    <span class="card-arrow" aria-hidden="true">→</span>
  </div>
</a>
