---
import BrandMark from "./BrandMark.astro";

interface Props {
  current?: "home" | "tema";
}

const { current = "home" } = Astro.props;
const homeHref = import.meta.env.BASE_URL;
---

<div class="site-top">
  <p class="brand-strip">Simple · Equilibrado · Relevante</p>
  <header class="site-header">
    <a class="brand" href={homeHref}>
      <span class="brand-lockup">
        <BrandMark />
        <span class="brand-sub">Leadership</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="Principal">
      <a href={homeHref} aria-current={current === "home" ? "page" : undefined}>Series</a>
    </nav>
  </header>
</div>
