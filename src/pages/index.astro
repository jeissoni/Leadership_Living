---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import TemaCard from "../components/TemaCard.astro";
import { seriesCatalog } from "../lib/series";

const temas = await getCollection("temas");
const base = import.meta.env.BASE_URL;

const seriesBlocks = seriesCatalog.map((serie) => ({
  ...serie,
  talks: temas
    .filter((tema) => tema.data.series === serie.id)
    .sort((a, b) => a.data.order - b.data.order),
}));
---

<Base
  title="Series"
  description="Series de charlas para voluntarios LivingRoom: el Reino, la Ley a Jesús, identidad, enemigos, el Espíritu, y Semilla y terreno."
>
  <section class="wrap hero">
    <p class="kicker">Charlas para voluntarios</p>
    <h1>Series de estudio</h1>
    <p class="lede">
      Apuntes para volver a cada charla: lo que conviene recordar y el sustento
      teológico. El guion para darla queda un clic más adentro.
    </p>
    <div class="gold-rule"></div>
    <nav class="series-jump no-print" aria-label="Series">
      {
        seriesCatalog.map((serie) => (
          <a class="chip" href={`#${serie.id}`}>
            {serie.title}
          </a>
        ))
      }
    </nav>
  </section>

  {
    seriesBlocks.map((serie) => (
      <section class="wrap series-block" id={serie.id} aria-labelledby={`${serie.id}-titulo`}>
        <header class="series-head">
          <p class="kicker">Serie</p>
          <h2 id={`${serie.id}-titulo`}>{serie.title}</h2>
          <p class="series-lede">{serie.lede}</p>
        </header>
        <div class="grid grid-tight">
          {serie.talks.map((tema) => (
            <TemaCard
              href={`${base}temas/${tema.id}/`}
              title={tema.data.title}
              description={tema.data.description}
              order={tema.data.order}
              duration={tema.data.duration}
              hasAudio={Boolean(tema.data.audio)}
            />
          ))}
        </div>
      </section>
    ))
  }
</Base>
