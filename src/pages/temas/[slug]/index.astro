---
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { audioHref, audioType } from "../../../lib/audio";
import { seriesById } from "../../../lib/series";
import { temaStaticPaths, type TemaEntry } from "../../../lib/tema-paths";

export const getStaticPaths = temaStaticPaths;

interface Props {
  tema: TemaEntry;
  prev?: TemaEntry;
  next?: TemaEntry;
  total: number;
}

const { tema, prev, next, total } = Astro.props;
const { Content } = await render(tema);
const serie = seriesById(tema.data.series);
const homeHref = import.meta.env.BASE_URL;
const base = import.meta.env.BASE_URL;
const mindMapSrc = `${base}mapa-mental-reino-de-dios.png`;
const guionHref = `${base}temas/${tema.id}/guion/`;
const audioSrc = tema.data.audio ? audioHref(base, tema.data.audio) : undefined;
const audioMime = tema.data.audio ? audioType(tema.data.audio) : undefined;
---

<Base title={tema.data.title} description={tema.data.description} current="tema">
  <article class="reading-shell" id="tema">
    <p class="print-masthead">
      Leadership Living · {serie?.title} · Recurso · Charla {tema.data.order} de {total}
    </p>

    <div class="reading-bar no-print">
      <a class="back" href={`${homeHref}#${tema.data.series}`}>← {serie?.title}</a>
      <button class="btn" id="exportar-pdf" type="button">Exportar PDF</button>
    </div>

    <p class="reading-kicker">Recurso · {serie?.title}</p>
    <h1 class="reading-title">{tema.data.title}</h1>
    <div class="meta">
      <span>Charla {tema.data.order} de {total}</span>
      {tema.data.duration && <span>· {tema.data.duration}</span>}
    </div>
    <div class="gold-rule"></div>

    <p class="guion-lede">{tema.data.description}</p>

    <blockquote class="thesis">
      <p class="thesis-label">En una frase</p>
      <p>{tema.data.thesis}</p>
    </blockquote>

    {
      audioSrc && (
        <section class="audio-summary no-print">
          <h2>Resumen en audio</h2>
          <p>Un recuento corto de la charla, para oír de nuevo.</p>
          <audio controls preload="metadata">
            {audioMime ? <source src={audioSrc} type={audioMime} /> : <source src={audioSrc} />}
            <a href={audioSrc}>Descargar el audio</a>
          </audio>
        </section>
      )
    }

    <section class="remember">
      <h2>Para recordar</h2>
      <ol>
        {tema.data.remember.map((point) => (
          <li>{point}</li>
        ))}
      </ol>
    </section>

    <div class="prose">
      <Content />
    </div>

    {
      tema.data.showMindMap && (
        <figure class="mind-map">
          <img src={mindMapSrc} alt="Mapa mental del Reino de Dios" />
          <figcaption>Mapa mental de la serie El Reino y el voluntario</figcaption>
        </figure>
      )
    }

    {
      tema.data.resources.length > 0 && (
        <section class="resources">
          <h2>Pasajes</h2>
          <ul class="resource-list">
            {tema.data.resources.map((resource) => (
              <li>
                {resource.url ? (
                  <a href={resource.url} rel="noopener noreferrer">
                    {resource.label}
                  </a>
                ) : (
                  <span>{resource.label}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="view-switch no-print">
      <a href={guionHref}>Guion para dar la charla</a>
    </p>

    <nav class="series-pager no-print" aria-label="Charlas de la serie">
      {
        prev ? (
          <a href={`${base}temas/${prev.id}/`}>
            <span>Anterior</span>
            <strong>{prev.data.title}</strong>
          </a>
        ) : (
          <span></span>
        )
      }
      {
        next ? (
          <a class="series-pager-next" href={`${base}temas/${next.id}/`}>
            <span>Siguiente</span>
            <strong>{next.data.title}</strong>
          </a>
        ) : (
          <span></span>
        )
      }
    </nav>
  </article>

  <script>
    document.getElementById("exportar-pdf")?.addEventListener("click", () => {
      window.print();
    });
  </script>
</Base>
